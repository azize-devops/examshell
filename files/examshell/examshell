  const traceName = S.attempts.length + '-' + name + '.trace';
  mkdirp(TRACES); fs.writeFileSync(path.join(TRACES, traceName), g.trace);
  S.attempts.push({ ex: name, level: BY[name].level, ok: g.ok, at: Date.now(), reason: g.reason || '' });
