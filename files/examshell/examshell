async function handle(line) {
  const parts = line.trim().split(/\s+/).filter(Boolean); const cmd = parts[0];
  if (!cmd) return;
  if (S.mode === 'exam' && timeLeft() <= 0) { console.log(yellow('Süre doldu.')); finish(); return; }
  switch (cmd) {
    case 'help': help(); break;
    case 'status': status(); break;
    case 'grademe': await grademe(); break;
    case 'subject': console.log(parts[1] === 'es' ? BY[S.current].es : BY[S.current].subject); break;
    case 'clear': process.stdout.write('\x1b[2J\x1b[H'); break;
    case 'policy': {
      if (S.mode !== 'exam') { console.log(red('policy: yalnızca sınav modunda anlamlı')); break; }
      const v = { n: 'new', s: 'same', a: 'ask', new: 'new', same: 'same', ask: 'ask' }[parts[1] || ''];
      if (!parts[1]) { console.log('Başarısızlıkta: ' + polName(S.failPolicy) + dim('\nDeğiştirmek için: policy new | policy same | policy ask')); break; }
      if (!v) { console.log(red('policy: new, same veya ask olmalı')); break; }
      S.failPolicy = v; save(); console.log('Başarısızlıkta: ' + polName(v));
      break;
    }
    case 'finish': {
      const a = await ask(S.mode === 'exam' ? 'Sınavı bitirmek istediğine emin misin? Puanın: ' + S.points + '/100 (y/n) ' : 'Pratik oturumu kapatılsın mı? (y/n) ');
      if (/^y(es)?$/i.test(a.trim())) finish();
      break;
    }
    case 'exit': case 'quit': save(); console.log(dim('Oturum kaydedildi. Devam etmek için tekrar: examshell')); process.exit(0); break;
    case 'next': case 'practice': case 'list':
      if (S.mode !== 'practice') { console.log(red(cmd + ': bu komut yalnızca pratik modunda var (examshell --practice)')); break; }
      if (cmd === 'list') { [1, 2, 3, 4].forEach(function (L) { console.log(bold('Level ' + L) + '  ' + levelEx(L).map(function (n) { return S.passed.indexOf(n) >= 0 ? green(n) : n; }).join('  ')); }); break; }
      {
        let n = parts[1];
        if (cmd === 'next') { const pool = levelEx(S.level).filter(function (x) { return S.passed.indexOf(x) < 0 && x !== S.current; }); n = rand(pool.length ? pool : levelEx(S.level).filter(function (x) { return x !== S.current; })); }
        if (!BY[n]) { console.log(red('practice: \'' + n + '\' diye bir soru yok (list ile bak)')); break; }
        assign(n);
      }
      break;
    default:
      console.log(red('examshell: ' + cmd + ': unknown command') + dim('  (help yaz. Kod yazmak ve derlemek için ayrı bir terminal kullan.)'));
  }
}

function startRepl() {
  rl = readline.createInterface({ input: process.stdin, output: process.stdout, terminal: process.stdin.isTTY,
    completer: function (l) { const cmds = ['grademe', 'status', 'subject', 'finish', 'help', 'exit', 'clear', 'policy', 'next', 'practice', 'list']; const h = cmds.filter(function (x) { return x.indexOf(l) === 0; }); return [h.length ? h : cmds, l]; } });
  rl.on('line', async function (line) {
    if (pendingYN) { const r = pendingYN; pendingYN = null; r(line); return; }
    if (busy) return;
    busy = true;
    try { await handle(line); } catch (err) { console.log(red('internal error: ' + (err && err.stack || err))); }
    busy = false; prompt();
  });
  rl.on('SIGINT', function () { if (pendingYN) { const r = pendingYN; pendingYN = null; console.log('^C'); r('n'); return; } console.log(dim('\n(Çıkmak için: exit — oturum kaydedilir)')); prompt(); });
  rl.on('close', function () { if (S && !S.done) save(); process.exit(0); });
  if (S.mode === 'exam') {
    let warned30 = false, warned10 = false;
    timerCheck = setInterval(function () {
      const l = timeLeft();
      if (l <= 0) { console.log(yellow('\n\nSüre doldu. Sınav sona erdi.')); finish(); }
      else if (l < 600 && !warned10) { warned10 = true; console.log(yellow('\n[!] Son 10 dakika.')); prompt(); }
      else if (l < 1800 && !warned30) { warned30 = true; console.log(yellow('\n[!] Son 30 dakika.')); prompt(); }
    }, 5000);
  }
  prompt();
}

