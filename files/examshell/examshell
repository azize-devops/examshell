const IGNORE_SYMS = new Set(['_GLOBAL_OFFSET_TABLE_', '__stack_chk_fail', '__gmon_start__', '_ITM_deregisterTMCloneTable', '_ITM_registerTMCloneTable', '__cxa_finalize', '__libc_start_main', '__stack_chk_guard']);

function collectFiles(name) {
  // returns { files: {fname: Buffer}, note }
  const out = {};
  if (!S.git) {
    const d = path.join(RENDU, name);
    if (fs.existsSync(d)) fs.readdirSync(d).forEach(function (f) { const p = path.join(d, f); if (fs.statSync(p).isFile()) out[f] = fs.readFileSync(p); });
    return { files: out, note: 'git kapalı — çalışma dosyaları' };
  }
  const refs = sh('git', ['--git-dir', BARE, 'for-each-ref', '--format=%(refname)', 'refs/heads']).stdout.trim().split('\n').filter(Boolean);
  if (!refs.length) return { files: out, note: 'vogsphere boş — hiç git push yapılmamış' };
  const cur = sh('git', ['-C', RENDU, 'rev-parse', '--abbrev-ref', 'HEAD']).stdout.trim();
  const ref = refs.indexOf('refs/heads/' + cur) >= 0 ? 'refs/heads/' + cur : refs[0];
  const ls = sh('git', ['--git-dir', BARE, 'ls-tree', '--name-only', ref, name + '/']).stdout.split('\n').filter(Boolean);
  ls.forEach(function (p) {
    const r = sh('git', ['--git-dir', BARE, 'cat-file', '-p', ref + ':' + p], { encoding: 'buffer' });
    if (r.status === 0) out[path.basename(p)] = r.stdout;
  });
  const log = sh('git', ['--git-dir', BARE, 'log', '--oneline', '-5', ref]).stdout.trim();
  return { files: out, note: 'vogsphere ' + ref.replace('refs/heads/', '') + '\n' + log };
}

function grade(name) {
  const e = BY[name];
  const bar = function (t) { return ('= ' + t + ' ').padEnd(80, '=') + '\n'; };
  let tr = bar('Host-specific information');
  tr += '$> hostname; uname -msr\n' + os.hostname() + '\n' + os.type() + ' ' + os.release() + ' ' + os.arch() + '\n$> date\n' + new Date().toString() + '\n$> gcc --version\n' + sh('gcc', ['--version']).stdout.split('\n')[0] + '\n\n';
  const col = collectFiles(name);
  tr += bar('User files collection') + 'Collecting user files from Vogsphere\n' + col.note + '\n\n';
  const fail = function (reason, extra) { return { ok: false, reason: reason, trace: tr + (extra || '') + '\n' + bar('Final grade: 0') }; };
  const sub = col.files;
  const exp = expectedList(e);
  const wild = exp.some(function (x) { return x.indexOf('*') >= 0; });
  const files = {};
  const lsTxt = function (m) { const k = Object.keys(m); return k.length ? k.map(function (f) { return '-rw-r--r-- 1 student student ' + String(m[f].length).padStart(5) + ' ' + f; }).join('\n') : '(boş)'; };
  if (wild) Object.keys(sub).forEach(function (f) { if (/\.[ch]$/.test(f)) files[f] = sub[f]; });
  else {
    const missing = exp.filter(function (f) { return !(f in sub); });
    tr += bar('Collected files') + '$> ls -lA rendu/' + name + '\n' + lsTxt(sub) + '\n\n';
    if (missing.length) return fail('dosya bulunamadı: ' + missing.join(', '), bar(name) + missing.map(function (f) { return 'rendu/' + name + '/' + f + ': No such file or directory'; }).join('\n') + '\n');
    exp.forEach(function (f) { files[f] = sub[f]; });
  }
  if (wild) tr += bar('Collected files') + '$> ls -lA rendu/' + name + '\n' + lsTxt(files) + '\n\n';
  const units = Object.keys(files).filter(function (f) { return /\.c$/.test(f); });
  if (!units.length) return fail('hiç .c dosyası yok', bar(name) + 'No .c file found in rendu/' + name + '\n');

  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'examshell-'));
  try {
    Object.keys(files).forEach(function (f) { fs.writeFileSync(path.join(tmp, f), files[f]); });
    Object.keys(e.provided || {}).forEach(function (f) { fs.writeFileSync(path.join(tmp, f), e.provided[f]); });
    const all = units.slice();
    if (e.kind === 'func') { fs.writeFileSync(path.join(tmp, 'moulinette_main.c'), e.main); all.push('moulinette_main.c'); }
    tr += bar(name) + '$> gcc -Wextra -Wall -Werror ' + all.join(' ') + ' -o user_exe\n';
    const cc = sh('gcc', ['-Wextra', '-Wall', '-Werror'].concat(all, ['-o', 'user_exe']), { cwd: tmp, env: Object.assign({}, process.env, { LC_ALL: 'C', GCC_COLORS: '' }) });
    if (cc.status !== 0) {
      let hint = '';
      if (/multiple definition of `main'/.test(cc.stderr)) hint = '\n(İpucu: Bu bir fonksiyon sorusu; teslim ettiğin dosyada main olmamalı.)\n';
      else if (e.kind === 'prog' && /undefined reference to `main'/.test(cc.stderr)) hint = '\n(İpucu: Bu bir program sorusu; main fonksiyonu gerekli.)\n';
      return fail('derleme hatası', cc.stderr + hint + '\nCompilation failed.\n');
    }
    // forbidden functions: compile user units with -fno-builtin and inspect undefined symbols
    const defined = new Set(), undef = new Set();
    for (let i = 0; i < units.length; i++) {
      const o = 'chk_' + i + '.o';
      const r = sh('gcc', ['-c', '-O0', '-fno-builtin', '-fno-stack-protector', units[i], '-o', o], { cwd: tmp });
      if (r.status !== 0) continue;
      sh('nm', ['-u', o], { cwd: tmp }).stdout.split('\n').forEach(function (l) { const m = l.trim().match(/^U\s+(\S+)/); if (m) undef.add(m[1].replace(/@.*/, '')); });
      sh('nm', ['--defined-only', o], { cwd: tmp }).stdout.split('\n').forEach(function (l) { const m = l.trim().match(/^\S+\s+[TtDdBbRrCc]\s+(\S+)/); if (m) defined.add(m[1]); });
    }
    const allowed = new Set(allowedList(e.allowed));
    const bad = Array.from(undef).filter(function (s) { return !defined.has(s) && !IGNORE_SYMS.has(s) && !allowed.has(s); }).sort();
    if (bad.length) return fail('yasak fonksiyon: ' + bad.join(', '), 'Allowed functions: ' + (e.allowed || '(none)') + '\nForbidden function(s) used: ' + bad.join(', ') + '\n\nCheating attempt detected: forbidden function.\n');
    // tests
    for (let n = 1; n <= e.tests.length; n++) {
      const t = e.tests[n - 1];
      tr += bar('Test ' + n) + '$> ./user_exe ' + t.args.map(shq).join(' ') + '\n';
      const r = cp.spawnSync(path.join(tmp, 'user_exe'), t.args, { cwd: tmp, timeout: 5000, encoding: 'latin1', stdio: ['ignore', 'pipe', 'pipe'], maxBuffer: 16 * 1024 * 1024 });
      if (r.error && r.error.code === 'ETIMEDOUT' || (r.signal && r.status === null)) {
        const to = r.error && r.error.code === 'ETIMEDOUT';
        const msg = to ? 'Timeout (program 5 saniyede bitmedi — sonsuz döngü?)' : ({ SIGSEGV: 'Segmentation fault (core dumped)', SIGBUS: 'Bus error (core dumped)', SIGABRT: 'Aborted (core dumped)', SIGFPE: 'Floating point exception (core dumped)' }[r.signal] || ('Killed by signal ' + r.signal));
        tr += msg + '\n' + (r.stderr ? r.stderr : '') + (r.stdout ? '\nÇökmeden önceki çıktı:\n' + catE(r.stdout) + '\n' : '') + '\nGrade: 0\n';
        return fail('test ' + n + ': ' + (to ? 'zaman aşımı' : 'çökme (' + r.signal + ')'), '');
      }
      tr += '$> diff -U 3 user_output_test' + n + ' test' + n + '.output | cat -e\n';
      if (r.stdout !== t.out) {
        tr += unifiedDiff(r.stdout, t.out, 'user_output_test' + n, 'test' + n + '.output') + '\nDiff KO :(\nGrade: 0\n';
        return fail('test ' + n + ': çıktı farklı', '');
      }
      tr += 'Diff OK :D\n';
    }
    tr += '\n' + bar('Final grade: 1');
    return { ok: true, trace: tr };
  } finally { rmrf(tmp); }
}

