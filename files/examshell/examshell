function allowedList(a) { return (!a || /^(none|-)$/i.test(a.trim())) ? [] : a.split(',').map(function (s) { return s.trim(); }).filter(Boolean); }
function expectedList(e) { return e.expected.split(',').map(function (s) { return s.trim(); }).filter(Boolean); }
function catE(s) {
  let o = '';
  for (let i = 0; i < s.length; i++) {
    const ch = s[i], k = s.charCodeAt(i);
    if (ch === '\n') o += '$\n'; else if (ch === '\t') o += '\t';
    else if (k < 32) o += '^' + String.fromCharCode(k + 64); else if (k === 127) o += '^?';
    else if (k >= 128 && k < 256) { const d = k - 128; o += 'M-' + (d < 32 ? '^' + String.fromCharCode(d + 64) : d === 127 ? '^?' : String.fromCharCode(d)); }
    else o += ch;
  }
  return o;
}
function shq(s) { return /^[\w./+:=,-]+$/.test(s) ? s : '"' + s.replace(/(["\\$`])/g, '\\$1').replace(/\n/g, '\\n').replace(/\t/g, '\\t') + '"'; }
function unifiedDiff(user, exp, nu, ne) {
  function split(s) { const a = s.split('\n'); const nl = s.endsWith('\n'); if (nl) a.pop(); const lines = a.map(function (x) { return catE(x) + '$'; }); const nonl = !nl && s.length > 0; if (nonl) lines[lines.length - 1] = lines[lines.length - 1].replace(/\$$/, ''); return { lines: lines, nonl: nonl }; }
  const U = split(user), E = split(exp); const a = U.lines, b = E.lines, n = a.length, m = b.length;
  if (n * m > 250000) return '--- ' + nu + '\n+++ ' + ne + '\n(çıktılar çok uzun: kullanıcı ' + n + ' satır, beklenen ' + m + ' satır)\n';
  const L = []; for (let i = 0; i <= n; i++) L.push(new Int32Array(m + 1));
  for (let i = n - 1; i >= 0; i--) for (let j = m - 1; j >= 0; j--) L[i][j] = a[i] === b[j] ? L[i + 1][j + 1] + 1 : Math.max(L[i + 1][j], L[i][j + 1]);
  const ops = []; let i = 0, j = 0;
  while (i < n || j < m) {
    if (i < n && j < m && a[i] === b[j]) { ops.push([' ', a[i++]]); j++; }
    else if (i < n && (j >= m || L[i + 1][j] >= L[i][j + 1])) ops.push(['-', a[i++]]);
    else ops.push(['+', b[j++]]);
  }
  let t = '--- ' + nu + '\n+++ ' + ne + '\n@@ -' + (n ? 1 : 0) + ',' + n + ' +' + (m ? 1 : 0) + ',' + m + ' @@\n';
  ops.slice(0, 60).forEach(function (o) { t += o[0] + o[1] + '\n'; });
  if (ops.length > 60) t += '... (' + (ops.length - 60) + ' satır daha)\n';
  if (U.nonl) t += '\\ No newline at end of file (user)\n';
  if (E.nonl) t += '\\ No newline at end of file (expected)\n';
  return t;
}

