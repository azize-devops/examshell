    console.log(dim('Trace: ' + tilde(path.join(TRACES, traceName))));
    const key = '= ' + (/^test/.test(g.reason) ? 'Test' : name);
    const blk = g.trace.slice(g.trace.lastIndexOf(key)).replace(/\n= Final grade[\s\S]*$/, '').trim();
